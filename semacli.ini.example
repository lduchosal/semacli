[semaphore]
url = https://monitor.example.com/semaphore
# Default project id (integer). Optional — many commands accept --project.
# project = 1

[auth]
# Authentication method: bearer_token or env_var
method = bearer_token
# For method = bearer_token:
bearer_token = your-api-token-here
# For method = env_var:
# env_var = SEMAPHORE_TOKEN

[settings]
timeout = 30

# verify_ssl = true is the secure default. Set to false ONLY for self-signed
# certificates in a trusted environment — traffic becomes vulnerable to MITM.
verify_ssl = true

# allow_http = false rejects plain http:// URLs (default). Set to true ONLY
# to talk to a Semaphore instance over plain HTTP — credentials and data
# travel in clear text.
# allow_http = false
